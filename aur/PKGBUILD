# Maintainer: Ian Swope <ian@smallswope.com>
pkgname=ralendar
pkgver=0.1.1
pkgrel=1
pkgdesc="Native GPUI chinese calendar for Linux"
arch=('x86_64')
url='https://github.com/PurestAsh/ralendar'
license=('MIT')
# depends=('sqlite')  'pkgconf'
makedepends=('cargo' 'fontconfig' 'sqlite' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland')
# optdepends=('gnome-keyring: store Google, iCloud, and CalDAV credentials')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
# Release checklist: replace SKIP with the SHA-256 of the immutable tagged
# archive before publishing this PKGBUILD to the AUR.
sha256sums=('71d9ba9d1a78e4f54f68597762cdd9bff3fbf65426d8fdf5cde62c7f29abdb12')
build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --locked --bin ralendar
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 ${pkgname}.desktop \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 ${pkgname}.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
}